{
	"name": "pole",
	"version": "0.1.0",
	"private": true,
  "type": "module",
	"scripts": {
		"dev": "bun --bun next dev",
		"build": "bun run db:generate && bun --bun next build",
		"start": "bun --bun next start",
		"lint": "eslint",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
		"db:generate": "bunx --bun prisma generate",
		"db:push": "bunx --bun prisma db push",
		"db:migrate": "bunx --bun prisma migrate dev",
		"db:studio": "bunx --bun prisma studio",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0",
		"@base-ui/react": "^1.9.0",
		"@hookform/resolvers": "^5.9.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.0",
		"lucide-react": "^1.58.0",
		"motion": "^14.3.0",
		"next": "16.4.2",
		"nodemailer": "^10.1.2",
		"pg": "^8.23.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.90.0",
		"server-only": "0.0.1",
		"shadcn": "^4.22.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@next/env": "16.4.2",
		"@tailwindcss/turbopack": "^4",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.2",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.10.1",
		"repomix": "^1.18.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "bun@1.4.3",
	"trustedDependencies": [
		"sharp",
		"unrs-resolver",
		"prisma",
		"@prisma/client"
	]
}
