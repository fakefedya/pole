generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  HIDDEN
  PUBLISHED
}

enum ProjectBlockType {
  HEADING
  PARAGRAPH
}

model Project {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(160)
  title String @db.VarChar(180)

  summary String?  @db.VarChar(320)
  tags    String[] @default([])

  status     ProjectStatus @default(DRAFT)
  showOnHome Boolean       @default(false)
  homeOrder  Int           @default(0)

  location       String?  @db.VarChar(160)
  areaSqM        Decimal? @db.Decimal(7, 2)
  style          String?  @db.VarChar(120)
  designDuration String?  @db.VarChar(100)
  year           Int?     @db.SmallInt

  extraDetails Json? @db.JsonB

  images ProjectImage[]        @relation("ProjectGallery")
  blocks ProjectContentBlock[]

  coverImageId String?       @unique
  coverImage   ProjectImage? @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, showOnHome, homeOrder])
}

model ProjectImage {
  id String @id @default(cuid())

  projectId String
  project   Project @relation("ProjectGallery", fields: [projectId], references: [id], onDelete: Cascade)

  coverFor Project? @relation("ProjectCover")

  objectKey String @unique @db.VarChar(240)
  alt       String @db.VarChar(240)

  width     Int
  height    Int
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model ProjectContentBlock {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      ProjectBlockType @default(PARAGRAPH)
  body      String           @db.Text
  sortOrder Int              @default(0)

  @@index([projectId, sortOrder])
}
